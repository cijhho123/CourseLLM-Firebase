# Memory Service Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# =============================================================================
# REQUIRED CONFIGURATION
# =============================================================================

# Node environment: development | production | test
NODE_ENV=development

# Service port (default: 3001)
PORT=3001

# PostgreSQL database connection string
# For local Docker: postgresql://postgres:postgres@localhost:5432/memory_service?schema=public
# For Cloud SQL: postgresql://user:pass@/dbname?host=/cloudsql/project:region:instance
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/memory_service?schema=public"

# =============================================================================
# MEMORY SYNTHESIS (mem0.ai)
# =============================================================================

# mem0.ai API key for memory synthesis
# Get your key at: https://app.mem0.ai/
# Leave empty to use mock implementation (development only)
MEM0_API_KEY=

# =============================================================================
# OPTIONAL CONFIGURATION
# =============================================================================

# Logging level: error | warn | info | debug | verbose
LOG_LEVEL=debug

# Google Cloud project ID (for Firebase Data Connect)
# Only needed if using Firebase Data Connect instead of direct PostgreSQL
GCLOUD_PROJECT=

# Firebase Data Connect emulator host
# Automatically set to 127.0.0.1:9399 in development if not specified
DATA_CONNECT_EMULATOR_HOST=

# =============================================================================
# CODESPACES / PROFESSOR TESTING
# =============================================================================
#
# Quick setup for GitHub Codespaces:
#
# 1. Copy this file:
#    cp .env.example .env
#
# 2. Start PostgreSQL:
#    docker-compose up -d
#
# 3. Run migrations:
#    npm run prisma:generate
#    npm run prisma:migrate
#
# 4. Start service:
#    npm run start:dev
#
# 5. Test health endpoint:
#    curl http://localhost:3001/health
#
# 6. Open Swagger UI:
#    http://localhost:3001/api/docs
#
# Note: MEM0_API_KEY is optional for basic testing.
# The service will use a mock implementation if not provided.
# =============================================================================
